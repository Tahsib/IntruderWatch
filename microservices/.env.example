# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# Stream credentials (default for most cameras)
STREAM_IP=192.168.50.88
STREAM_USERNAME=your_username
STREAM_PASSWORD=your_password

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBERS=+1234567890

# Active camera profiles (comma-separated)
# Available: cam1, cam2, cam3, cam4, cam5, cam6, cam7, cam8
COMPOSE_PROFILES=cam1,cam2,cam3,cam4,cam5,cam6,cam7,cam8

# Frame Capturer
START_TIME=00:30:00
END_TIME=17:30:00
# Motion sensitivity (MSE). 5.0 is safe for noisy nights, 2.0 is more sensitive.
MOTION_THRESHOLD=5.0

# Detection
INFERENCE_SIZE=1280
DETECTION_CONFIDENCE=0.8

# Alerts
ALERT_COOLDOWN=60

# Viewer Auth
VIEWER_USERNAME=admin
VIEWER_PASSWORD=password123

# ntfy Private Alerts
NTFY_BASE_URL=http://localhost:8081
# Internal container URL for reliable notification delivery
NTFY_INTERNAL_URL=http://ntfy
VIEWER_BASE_URL=http://localhost:8085
ALERT_BYPASS_TOKEN=your_secure_bypass_token_here
